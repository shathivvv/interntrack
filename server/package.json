{
  "name": "interntrack-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
    "eval": "node --env-file-if-exists=.env evals/run.js",
    "eval:retrieval": "node --env-file-if-exists=.env evals/retrieval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.2"
  }
}
