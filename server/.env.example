# Copy to .env (for npm run dev / npm run migrate) and .env.test (for npm test).
# Never commit .env or .env.test — .gitignore blocks them.

# Neon connection string: Neon dashboard → Connect.
# .env      → the `dev` branch
# .env.test → the `test` branch (tests may wipe tables)
# Use sslmode=verify-full (not require): it verifies Neon's certificate, and it keeps
# meaning that when pg v9 makes `require` weaker.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

PORT=3000
